{
  "name": "@papillon6814/copi",
  "version": "0.5.0",
  "description": "Collect and organize reusable Pi coding-agent resources",
  "license": "MIT",
  "type": "module",
  "bin": {
    "copi": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/native",
    "README.md",
    "LICENSE",
    "LICENSE.unicode"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-native.mjs",
    "test": "npm run build && node --import ./dist/test/helpers/test-env.js --test dist/test/*.test.js",
    "check": "npm run build && npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "^1.8.1",
    "diff": "^9.0.0",
    "fast-string-width": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.9.2"
  }
}
